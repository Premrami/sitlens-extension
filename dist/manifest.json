{
    "manifest_version": 3,
    "name": "SiteLens AI",
    "version": "0.1.0",
    "description": "Website and meeting intelligence directly from your browser.",
    "permissions": [
        "sidePanel",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "Open SiteLens AI"
    },
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}